{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://jlaudio.github.io/jl-mixing/api/v1.0/schemas/operations/client-files-import-execute.schema.json",
  "type":"object","additionalProperties":true,
  "required":["api_version","operation","status","data","warnings","errors"],
  "properties":{
    "api_version":{"const":"1.0"},"operation":{"const":"client.files.import.execute"},
    "status":{"enum":["success","blocked","error"]},
    "data":{"type":"object","additionalProperties":true,"properties":{
      "project":{"type":"object","additionalProperties":true},
      "plan_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},
      "result":{"type":"object","additionalProperties":true,"required":["items","invalidations"],"properties":{
        "items":{"type":"array","items":{"type":"object","required":["id","result"],"properties":{"result":{"enum":["created","replaced","skipped"]}}}},
        "invalidations":{"type":"array","items":{"type":"string"},"uniqueItems":true}
      }}
    }},"warnings":{"type":"array"},"errors":{"type":"array"}
  }
}
