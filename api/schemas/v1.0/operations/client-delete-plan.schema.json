{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jlaudio.github.io/jl-mixing/api/v1.0/schemas/operations/client-delete-plan.schema.json",
  "type": "object", "additionalProperties": true,
  "required": ["api_version", "operation", "status", "data", "warnings", "errors"],
  "properties": {
    "api_version": {"const": "1.0"},
    "operation": {"const": "client.delete.plan"},
    "status": {"enum": ["planned", "blocked", "error"]},
    "data": {"type": "object", "additionalProperties": true, "properties": {
      "summary": {"type": "object", "additionalProperties": true,
        "required": ["client", "project_count", "file_count", "total_bytes", "includes", "recoverable", "fingerprint"],
        "properties": {
          "client": {"type": "object", "required": ["id", "name", "path", "document_id"]},
          "project_count": {"const": 0},
          "file_count": {"type": "integer", "minimum": 1},
          "total_bytes": {"type": "integer", "minimum": 0},
          "includes": {"type": "array", "items": {"type": "string"}},
          "recoverable": {"const": false},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "deleted": {"const": false},
      "recoverable": {"const": false}
    }},
    "warnings": {"type": "array"}, "errors": {"type": "array"}
  }
}
