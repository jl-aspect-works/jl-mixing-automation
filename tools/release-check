#!/usr/bin/env bash
# Execute every release gate and verify the generated end-user archive.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# Source behavior and static shell quality must pass before packaging.
make strict-test
tools/shellcheck-all

release_dir="$(mktemp -d "${TMPDIR:-/tmp}/jl-mixing-release-output.XXXXXX")"
cleanup() { rm -rf -- "$release_dir"; }
trap cleanup EXIT HUP INT TERM

tools/build-release --output-dir "$release_dir"
archive="$(find "$release_dir" -maxdepth 1 -name '*.tar.gz' -type f | head -n 1)"
[ -n "$archive" ] || { echo "Release archive was not created." >&2; exit 5; }
tools/verify-release-archive "$archive"

echo "[OK] v$(cat VERSION) release check passed"
