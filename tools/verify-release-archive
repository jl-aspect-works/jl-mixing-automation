#!/usr/bin/env bash
# Verify structure, permissions, installation, upgrade, and uninstallation for
# one end-user release archive.
set -eu

[ "$#" -eq 1 ] || {
    echo "Usage: tools/verify-release-archive ARCHIVE.tar.gz" >&2
    exit 2
}

archive="$1"
[ -f "$archive" ] || { echo "Archive not found: $archive" >&2; exit 3; }

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/jl-mixing-release-check.XXXXXX")"
cleanup() { rm -rf -- "$work_dir"; }
trap cleanup EXIT HUP INT TERM

tar -xzf "$archive" -C "$work_dir"
package_root="$(find "$work_dir" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
[ -n "$package_root" ] || { echo "Release archive has no top-level directory." >&2; exit 5; }
# Reject development-only content from an end-user package.
for forbidden in .git .github tests examples .venv; do
    if [ -e "$package_root/$forbidden" ]; then
        echo "Forbidden release content: $forbidden" >&2
        exit 5
    fi
done

for required in install.sh uninstall.sh VERSION API_VERSION LICENSE README.md CHANGELOG.md RELEASE_MANIFEST.txt \
    bin/jl-mixing api/schemas/v1.0/system-info.schema.json \
    api/examples/v1.0/success/system-info.json lib schemas templates docs tools/validate-json.py tools/build-intake-report.py tools/project-state.py \
    tools/import-project-source.py tools/import-revision-source.py tools/build-delivery.py \
    tools/manage-shell-config.py packaging/requirements.txt; do
    [ -e "$package_root/$required" ] || {
        echo "Missing release content: $required" >&2
        exit 5
    }
done
package_version="$(sed -n '1p' "$package_root/VERSION")"
expected_created_with="jl-mixing $package_version"


[ ! -e "$package_root/bin/complete-project" ] || { echo "Obsolete complete-project command was packaged." >&2; exit 5; }
[ ! -e "$package_root/schemas/legacy" ] || { echo "Legacy schemas were packaged." >&2; exit 5; }
[ ! -e "$package_root/templates/project" ] || { echo "Obsolete project templates were packaged." >&2; exit 5; }

[ -x "$package_root/install.sh" ] || { echo "install.sh is not executable." >&2; exit 5; }
[ -x "$package_root/bin/jl-mixing" ] || { echo "API dispatcher is not executable." >&2; exit 5; }
[ -x "$package_root/bin/new-studio" ] || { echo "commands are not executable." >&2; exit 5; }

# Use system packages only inside verification. Production installs remain
# isolated and install the pinned dependency normally.
prefix="$work_dir/prefix"
workspace="$work_dir/studio-workspace"
fake_home="$work_dir/home"
mkdir -p "$fake_home"
HOME="$fake_home" SHELL=/bin/bash JL_MIXING_TEST_SYSTEM_SITE_PACKAGES=1 \
    "$package_root/install.sh" --prefix "$prefix" >/dev/null
[ -f "$fake_home/.bashrc" ] || { echo "Installer did not configure .bashrc." >&2; exit 5; }
[ -f "$prefix/bin/jl-mixing-shell-integration" ] || { echo "Shell integration was not installed." >&2; exit 5; }
[ -x "$prefix/bin/jl-mixing" ] || { echo "Automation API dispatcher was not installed." >&2; exit 5; }
api_info="$work_dir/system-info.json"
PATH="$prefix/bin:$PATH" jl-mixing system-info --json > "$api_info"
[ "$(jq -r '.api_version // empty' "$api_info" | tr -d ' ')" = "$(cat "$package_root/API_VERSION")" ] || {
    echo "Installed dispatcher reported the wrong API version." >&2
    exit 5
}
[ "$(jq -r '.application.version' "$api_info")" = "$package_version" ] || {
    echo "Installed dispatcher reported the wrong application version." >&2
    exit 5
}
[ "$(jq -r '.capabilities | index("system.info") != null' "$api_info")" = "true" ] || {
    echo "Installed dispatcher omitted system.info capability." >&2
    exit 5
}
installed_schema_path="$(cd "$prefix/share/jl-mixing/api/schemas/v1.0" && pwd -P)"
[ "$(jq -r '.schemas.installed_path' "$api_info")" = "$installed_schema_path" ] || {
    echo "Installed dispatcher reported the wrong schema path." >&2
    exit 5
}
PATH="$prefix/bin:$PATH" new-studio --root "$workspace" >/dev/null
[ -f "$workspace/Studio/studio.json" ] || {
    echo "Installed command failed to create studio.json." >&2
    exit 5
}
[ "$(jq -r '.metadata.schema_version' "$workspace/Studio/studio.json")" = "1.1.0" ] || {
    echo "Installed new-studio changed the metadata schema version." >&2
    exit 5
}
[ "$(jq -r '.metadata.created_with' "$workspace/Studio/studio.json")" = "$expected_created_with" ] || {
    echo "Installed new-studio did not record the package release version." >&2
    exit 5
}
[ ! -e "$prefix/bin/complete-project" ] || {
    echo "Obsolete complete-project launcher was installed." >&2
    exit 5
}
JL_MIXING_ROOT="$workspace" PATH="$prefix/bin:$PATH" \
    new-client release-client \
        --name "Release Client" \
        --artist "Release Test Artist" >/dev/null
client_root="$workspace/Clients/Release Client"

stored_artist="$(jq -r '.defaults.artist // empty' "$client_root/client.json")"
[ "$stored_artist" = "Release Test Artist" ] || {
    echo "Installed new-client did not preserve the configured artist." >&2
    exit 5
}

JL_MIXING_ROOT="$workspace" PATH="$prefix/bin:$PATH" \
    new-mix \
        --client release-client \
        --project "Release Project" \
        --artist "Release Test Artist" >/dev/null
project_root="$client_root/Projects/Release Project"
[ -f "$project_root/04_Revisions/Revision_01/Revision_Notes.md" ] || {
    echo "Installed new-mix did not create Revision 1." >&2
    exit 5
}
printf 'release notes\n' > "$project_root/01_Client_Files/Original_Delivery/Notes.txt"
PATH="$prefix/bin:$PATH" validate-intake --project "$project_root" >/dev/null
printf 'release mix\n' > "$project_root/04_Revisions/Revision_01/Release Main Mix.wav"
PATH="$prefix/bin:$PATH" approve-mix --project "$project_root" \
    --date 2030-01-01T12:00:00Z >/dev/null
PATH="$prefix/bin:$PATH" create-delivery --project "$project_root" >/dev/null
[ -f "$project_root/05_Final_Delivery/delivery-manifest.json" ] || {
    echo "Installed workflow failed to create delivery manifest." >&2
    exit 5
}

# Reinstall over the same prefix to exercise the transactional upgrade path.
HOME="$fake_home" SHELL=/bin/bash JL_MIXING_TEST_SYSTEM_SITE_PACKAGES=1 \
    "$package_root/install.sh" --prefix "$prefix" >/dev/null
[ -f "$workspace/Studio/studio.json" ] || {
    echo "Upgrade modified the studio workspace." >&2
    exit 5
}

HOME="$fake_home" SHELL=/bin/bash "$prefix/bin/jl-mixing-uninstall" >/dev/null
[ ! -e "$fake_home/.bashrc" ] || { echo "Uninstall left installer-created .bashrc." >&2; exit 5; }
[ ! -e "$prefix/share/jl-mixing" ] || {
    echo "Application remained after uninstall." >&2
    exit 5
}
[ -f "$workspace/Studio/studio.json" ] || {
    echo "Uninstall modified the studio workspace." >&2
    exit 5
}

printf '[OK] Release archive verified: %s\n' "$archive"
