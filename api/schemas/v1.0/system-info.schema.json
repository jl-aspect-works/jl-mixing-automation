{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jlaudio.github.io/jl-mixing/api/v1.0/schemas/system-info.schema.json",
  "title": "JL Mixing Automation API 1.0 System Information",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "api_version",
    "application",
    "metadata",
    "capabilities",
    "schemas"
  ],
  "properties": {
    "api_version": {
      "const": "1.0"
    },
    "application": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "jl-mixing"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "readable_schema_versions",
        "writable_schema_version"
      ],
      "properties": {
        "readable_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "writable_schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "installed_path",
        "public_base_url"
      ],
      "properties": {
        "installed_path": {
          "type": "string",
          "minLength": 1
        },
        "public_base_url": {
          "const": "https://jlaudio.github.io/jl-mixing/api/v1.0/schemas/"
        }
      }
    }
  }
}
