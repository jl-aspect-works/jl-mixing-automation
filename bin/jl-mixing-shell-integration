#!/usr/bin/env bash
# JL Mixing Automation managed shell integration.
# Source this file from bash or zsh; do not execute it as a standalone command.

_jl_mixing_is_sourced=0
if [ -n "${ZSH_VERSION:-}" ]; then
    case "${ZSH_EVAL_CONTEXT:-}" in
        *:file) _jl_mixing_is_sourced=1 ;;
    esac
elif [ -n "${BASH_VERSION:-}" ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
    _jl_mixing_is_sourced=1
fi

if [ "$_jl_mixing_is_sourced" -ne 1 ]; then
    echo "This file must be sourced by bash or zsh." >&2
    echo 'Run: source "$(command -v jl-mixing-shell-integration)"' >&2
    exit 2
fi
unset _jl_mixing_is_sourced

# Mark integration availability for command diagnostics only. Commands do not
# trust this value for authorization or path validation.
export JL_MIXING_SHELL_INTEGRATION=1

_jl_mixing_secure_result_file() {
    local result_file temp_dir template

    # macOS commonly exports TMPDIR with a trailing slash. Normalize it before
    # constructing the result-file template so the path contains no empty
    # segments that the command-side safety validator would reject.
    temp_dir="${TMPDIR:-/tmp}"
    while [ "$temp_dir" != "/" ] && [ "${temp_dir%/}" != "$temp_dir" ]; do
        temp_dir="${temp_dir%/}"
    done
    case "$temp_dir" in
        /) template="/jl-mixing-cd.XXXXXX" ;;
        *) template="$temp_dir/jl-mixing-cd.XXXXXX" ;;
    esac

    result_file="$(umask 077 && mktemp "$template")" || return 1
    chmod 600 "$result_file" 2>/dev/null || {
        rm -f -- "$result_file"
        return 1
    }
    printf '%s\n' "$result_file"
}

_jl_mixing_run_creation_command() {
    local command_name result_file command_status destination line_count
    command_name="$1"
    shift

    result_file="$(_jl_mixing_secure_result_file)" || {
        echo "Error: unable to create secure JL Mixing shell result file." >&2
        return 1
    }

    JL_MIXING_CD_RESULT_FILE="$result_file" command "$command_name" "$@"
    command_status=$?
    if [ "$command_status" -ne 0 ]; then
        rm -f -- "$result_file"
        return "$command_status"
    fi

    if [ ! -s "$result_file" ]; then
        rm -f -- "$result_file"
        return 0
    fi

    line_count="$(awk 'END { print NR }' "$result_file")" || line_count=0
    if [ "$line_count" -ne 1 ]; then
        echo "Error: creation succeeded, but JL Mixing returned an invalid directory result." >&2
        rm -f -- "$result_file"
        return 1
    fi
    destination=""
    IFS= read -r destination < "$result_file" || true
    rm -f -- "$result_file"

    case "$destination" in
        /*) ;;
        *)
            echo "Error: creation succeeded, but JL Mixing returned a non-absolute directory." >&2
            return 1
            ;;
    esac
    if [ ! -d "$destination" ]; then
        echo "Error: creation succeeded, but the requested directory does not exist: $destination" >&2
        return 1
    fi

    builtin cd -- "$destination" || {
        echo "Error: creation succeeded, but the shell could not enter: $destination" >&2
        return 1
    }
    printf 'Entered: %s\n' "$destination"
}

new-client() {
    _jl_mixing_run_creation_command new-client "$@"
}

new-mix() {
    _jl_mixing_run_creation_command new-mix "$@"
}

new-revision() {
    _jl_mixing_run_creation_command new-revision "$@"
}
