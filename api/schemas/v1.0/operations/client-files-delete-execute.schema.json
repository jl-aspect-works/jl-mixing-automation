{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jlaudio.github.io/jl-mixing/api/v1.0/schemas/operations/client-files-delete-execute.schema.json",
  "type": "object", "additionalProperties": true,
  "required": ["api_version", "operation", "status", "data", "warnings", "errors"],
  "properties": {
    "api_version": {"const": "1.0"},
    "operation": {"const": "client.files.delete.execute"},
    "status": {"enum": ["success", "blocked", "error"]},
    "data": {"type": "object", "additionalProperties": true, "properties": {
      "summary": {"type": "object"}, "deleted": {"type": "boolean"},
      "partial_cleanup": {"type": "boolean"}, "remaining_path": {"type": "string"},
      "recoverable": {"const": false}
    }},
    "warnings": {"type": "array"}, "errors": {"type": "array"}
  }
}
